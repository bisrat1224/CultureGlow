# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
#
# ---------------------------------------------------------------------------
# BUILD TIME vs RUN TIME - this matters for the Kubernetes deployment.
#
# Every page that reads Contentful is statically rendered, and NEXT_PUBLIC_*
# is substituted into the browser bundle at compile time. So both groups below
# are baked into the container image and CANNOT be changed by editing the
# Deployment: they are set as Docker build-args in
# .github/workflows/deploy-dev.yml. Changing them needs a rebuild + redeploy.
#
# Only the "Server-only forms" group is read at request time, and that is the
# group backed by the `culture-glow-secrets` Kubernetes Secret. 
# ---------------------------------------------------------------------------

# === Public, BUILD TIME (safe in browser - shipped in the JS bundle) ===
# In CI these come from repo Variables, not Secrets:
#   DEV_WHATSAPP_NUMBER, DEV_GA_MEASUREMENT_ID
NEXT_PUBLIC_WHATSAPP_NUMBER=251900000000
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# === Server-only forms, RUN TIME ===
# In dev these live in the `culture-glow-secrets` Secret in namespace `dev`.
RESEND_API_KEY=
CONTACT_FORM_RECIPIENT_EMAIL=
CATERING_FORM_RECIPIENT_EMAIL=

# === Contentful (Phase 1), BUILD TIME ===
# In CI: CONTENTFUL_SPACE_ID / CONTENTFUL_DELIVERY_TOKEN /
# CONTENTFUL_PREVIEW_TOKEN are repo Secrets, CONTENTFUL_ENVIRONMENT is the
# DEV_CONTENTFUL_ENVIRONMENT variable.
# Also mirrored into the `culture-glow-contentful-secrets` Secret in namespace
# `dev`, which only takes effect for request-time rendering (preview mode and
# the Phase 2 on-demand revalidation work).
CONTENTFUL_SPACE_ID =
CONTENTFUL_ENVIRONMENT =
CONTENTFUL_DELIVERY_TOKEN =
CONTENTFUL_PREVIEW_TOKEN =
# Management token: WRITE-scoped, and used only by scripts/contentful/*
# (bootstrap / seed). The Next.js app never reads it. It is carried alongside
# the other Contentful vars - repo Secret in CI, and a key in the
# `culture-glow-contentful-secrets` Secret in namespace `dev` - so that
# operators have it to hand. Rotate it in Contentful if either is exposed.
CONTENTFUL_MANAGEMENT_TOKEN=

# When true, Next.js prefers Contentful and falls back to TS on error/empty.
# When false, always uses local TS (useful while seeding).
# In CI this is the DEV_CONTENTFUL_ENABLED variable, defaulting to false.
CONTENTFUL_ENABLED=true
